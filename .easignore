# O que a Expo NÃO envia para a nuvem ao compilar o app (apps/mobile).
#
# Com este arquivo, a Expo ignora os .gitignore: as regras deles estão
# repetidas aqui. O ponto principal é o pnpm-workspace.yaml: sem ele, o pnpm
# instala o app sozinho com o lockfile dele (como no deploy, que usa
# --ignore-workspace), em vez de tentar instalar o site inteiro.

# Workspace do site
/pnpm-workspace.yaml
/package.json
/pnpm-lock.yaml
/.npmrc
/turbo.json

# Partes do repositório que o app não usa (o app só lê os tipos de packages/shared)
/apps/web
/apps/admin
/apps/realtime
/apps/worker
/apps/sms-gateway
/apps/cliente-android
/packages/auth
/packages/config
/packages/database
/packages/services
/packages/ui
/e2e
/docs
/docker
/scripts
/assets
/assets-gerados
/.github

# Regras do .gitignore da raiz
node_modules
.pnpm-store
.next
out
dist
build
.turbo
*.tsbuildinfo
.env
.env.local
.env.*.local
coverage
playwright-report
test-results
*.log
.DS_Store
.idea
.vscode
CREDENCIAIS.md

# Regras do .gitignore do app
/apps/mobile/.expo
/apps/mobile/web-build
/apps/mobile/expo-env.d.ts
/apps/mobile/.kotlin
/apps/mobile/ios
/apps/mobile/android
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.metro-health-check*
