{
  "expo": {
    "name": "Rapidinho",
    "slug": "rapidinho",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/marca/icone.png",
    "scheme": "rapidinho",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F2",
    "android": {
      "package": "br.com.rapidinhoentrega.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#FF5A1F",
        "foregroundImage": "./assets/marca/icone-adaptativo.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF5A1F",
          "image": "./assets/marca/abertura-android.png",
          "imageWidth": 288
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Rapidinho usa sua localização para preencher o endereço de entrega e, no modo entregador, para o cliente acompanhar a corrida."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Rapidinho usa a câmera para fotografar a receita ou o comprovante do Pix.",
          "photosPermission": "O Rapidinho usa suas fotos para anexar a receita ou o comprovante do Pix.",
          "microphonePermission": "O Rapidinho usa o microfone só quando você toca no botão de falar, para ditar a lista de compras."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Rapidinho usa o microfone só quando você toca no botão de falar, para ditar a lista de compras.",
          "speechRecognitionPermission": "O Rapidinho transforma sua fala em texto para montar a lista de compras.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": { "compileSdkVersion": 37, "targetSdkVersion": 36, "kotlinVersion": "2.3.20" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
