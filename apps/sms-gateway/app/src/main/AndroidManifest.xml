<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ler os SMS que chegam: é o que o cliente envia para confirmar o número. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Repassar ao servidor do Rapidinho. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pedir para sair da economia de bateria: sem isso o Android pode
         atrasar o repasse com a tela apagada. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Rapidinho SMS"
        android:networkSecurityConfig="@xml/rede"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link "Configurar o app neste celular" do painel da plataforma. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rapidinhosms" android:host="configurar" />
            </intent-filter>
        </activity>

        <!-- Só o sistema (que tem BROADCAST_SMS) pode entregar SMS a este
             receptor: outro app não consegue fingir um SMS recebido. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
