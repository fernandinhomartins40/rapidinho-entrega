# =============================================================================
# Rapidinho Entrega — variáveis de ambiente
# Copie para .env e ajuste. Nenhum valor aqui deve ser um segredo real.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=rapidinho
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rapidinho
# Dentro do docker-compose o host é "postgres"; fora dele use localhost:5432
DATABASE_URL=postgresql://rapidinho:troque-esta-senha@postgres:5432/rapidinho?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, filas BullMQ e adapter do Socket.io)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Autenticação (Auth.js)
# Gere com: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=gere-um-segredo-com-openssl-rand-base64-32
AUTH_URL=http://localhost/api/auth
AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# URLs públicas
# Em produção: https://rapidinhoentrega.com.br e https://painel.rapidinhoentrega.com.br
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL=http://localhost
NEXT_PUBLIC_ADMIN_URL=http://localhost/painel
NEXT_PUBLIC_SOCKET_URL=http://localhost

# -----------------------------------------------------------------------------
# Storage de imagens (MinIO — compatível com S3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=rapidinho
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=troque-esta-senha-minio
S3_FORCE_PATH_STYLE=true
# URL pública pela qual o navegador acessa as imagens
S3_PUBLIC_URL=http://localhost/uploads

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-minio

# -----------------------------------------------------------------------------
# Pagamentos
# PAYMENT_PROVIDER: mercadopago | asaas | fake (fake = desenvolvimento, sem rede)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3

# -----------------------------------------------------------------------------
# WhatsApp
# WHATSAPP_PROVIDER: evolution | cloud | fake
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=fake
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=rapidinho

# -----------------------------------------------------------------------------
# OTP (login por telefone)
# OTP_PROVIDER: whatsapp | sms | console (console = imprime o código no log)
# -----------------------------------------------------------------------------
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# E-mail transacional (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Rapidinho Entrega <nao-responda@rapidinhoentrega.com.br>

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# Gere com: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@rapidinhoentrega.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Nginx / domínios
#
# O painel usa SUBDOMÍNIO, não caminho: o Next monta os links a partir da raiz
# e servir o painel em /painel daria 404 em toda navegação interna.
# Em desenvolvimento, acesse o painel direto em localhost:3001.
# -----------------------------------------------------------------------------
WEB_DOMAIN=rapidinhoentrega.com.br
ADMIN_DOMAIN=painel.rapidinhoentrega.com.br

# -----------------------------------------------------------------------------
# Porta externa
#
# Em desenvolvimento o Nginx publica na 80 em todas as interfaces.
# Em produção o deploy escolhe uma porta livre, grava DEPLOY_PORT aqui e prende
# o bind no loopback — quem expõe à internet, com TLS, é o Nginx do host.
# -----------------------------------------------------------------------------
NGINX_BIND=0.0.0.0
HTTP_PORT=80
