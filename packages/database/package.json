{
  "name": "@rapidinho/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./generated/client": "./generated/client/index.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed/index.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:essencial": "tsx prisma/seed/index.ts --essencial",
    "seed:e2e": "tsx prisma/seed/e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@rapidinho/config": "workspace:*",
    "@rapidinho/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
